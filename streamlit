import streamlit as st
import requests
import pandas as pd
import joblib

# --- Load trained model ---
model = joblib.load("models/ux_model.pkl")

st.title("UX Audit App")

uploaded_file = st.file_uploader("Upload CSV with sessions", type=["csv"])
if uploaded_file:
    df = pd.read_csv(uploaded_file)
    st.write(df.head())

    features = ["Session_Duration (seconds)", "CTR (%)", "Bounce_Rate (%)", "Pages_Viewed"]
    
    if all(col in df.columns for col in features):
        predictions = model.predict(df[features])
        df["Predicted_Conversion"] = predictions
        st.write("Predictions:")
        st.dataframe(df)
    else:
        st.error(f"CSV must contain columns: {features}")